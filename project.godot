; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="backlands-godot"
run/main_scene="res://client/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
run/max_fps.android_emulator=30

[importer_defaults]

; Pixel art: sem compressão VRAM e sem mipmaps. O padrão do Godot é
; detect_3d/compress_to=1, que reimporta a textura silenciosamente com
; compressão assim que um nó 3D a usa — e isso destrói as bordas duras da arte.
; TextureFilter=Nearest não salva: corrige magnificação, não texels já perdidos.
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="backlands-godot"

[editor_plugins]

enabled=PackedStringArray("res://addons/raw_assets/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.android_emulator="gl_compatibility"
